# Copy to server/agent/.env (gitignored). These never leave this server.

# OpenAI: without a key, /api/analyze-incident returns the deterministic fallback.
OPENAI_API_KEY=
# Optional. Defaults to the @openai/agents SDK default model (gpt-5.6-luna).
OPENAI_MODEL=
# Optional. Per-attempt timeout before falling back. Default 20000.
OPENAI_TIMEOUT_MS=20000
# Optional. Set to 1 to stop the Agents SDK exporting traces to the OpenAI dashboard.
OPENAI_AGENTS_DISABLE_TRACING=

# GitHub: fine-grained PAT with "Issues: Read and write" on the target repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=isaiyahe/agent-hackathon

# Optional server settings.
PORT=3002
HOST=127.0.0.1
CORS_ORIGINS=chrome-extension://*,http://localhost:5173,http://localhost:5174
