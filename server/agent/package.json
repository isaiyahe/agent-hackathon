{
  "name": "repro-agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "REPRO incident analysis (OpenAI) and GitHub issue creation. Holds all server-side secrets.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@openai/agents": "^0.18.0",
    "hono": "^4.13.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "openai": "^7.15.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
