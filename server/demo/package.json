{
  "name": "repro-demo-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic failure harness (seeded guest checkout bug) for the REPRO demo",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
